{
  "manifest_version": 1,
  "app_id": "document-triage",
  "name": "Document Triage Pipeline",
  "version": "1.0.0",
  "capabilities": [
    "inference"
  ],
  "models": [
    {
      "role": "vectorizer",
      "file": "models/triage_vectorizer.pkl",
      "format": "pickle",
      "sha256": "bb3abb646c7cea250de755f572d9285eff4ddf5b460b3ada9fa7355c930167c1"
    },
    {
      "role": "topic",
      "file": "models/triage_topic.pkl",
      "format": "pickle",
      "sha256": "2b167d06f8840466d52ca84c23dbb7974e6cbadabad86237aa15536c07ca6f64",
      "depends_on": "vectorizer"
    },
    {
      "role": "sentiment",
      "file": "models/triage_sentiment.pkl",
      "format": "pickle",
      "sha256": "c6b1ca0ec2cc91eeeb48fd314c5a0e7f7f9d8b7015c72a31d7e10304efc958d3"
    }
  ],
  "adapter": {
    "entry": "adapter/main.py",
    "files": [
      {
        "file": "adapter/main.py",
        "sha256": "d0e31f9ead25ccf5afacb241b0d8877f38f2257cc583aaf3ebdc4b8e15e85bcf"
      }
    ]
  },
  "release": {
    "key_id": "sydeco-test-key-v1",
    "signature": "manifest.sig"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string",
        "maxLength": 100000
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "topic",
      "sentiment",
      "urgency",
      "confidence"
    ],
    "properties": {
      "topic": {
        "type": "string"
      },
      "sentiment": {
        "type": "string",
        "enum": [
          "positive",
          "negative"
        ]
      },
      "urgency": {
        "type": "string",
        "enum": [
          "low",
          "high",
          "review"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "permissions": {
    "network": "none"
  },
  "api": {
    "authentication": "token"
  },
  "resource_limits": {
    "max_memory": 2147483648,
    "max_cpu": 100,
    "inference_timeout": 120,
    "concurrency": 1
  },
  "dependencies": [],
  "inference": {
    "seed": 42
  }
}
